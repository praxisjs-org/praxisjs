{
  "name": "praxisjs-monorepo",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docs:dev": "pnpm --filter @praxisjs/docs dev",
    "docs:build": "pnpm --filter @praxisjs/docs build",
    "docs:preview": "pnpm --filter @praxisjs/docs start",
    "prepare": "husky",
    "build:foundation": "pnpm --filter './packages/foundation/**' build",
    "build:features": "pnpm --filter './packages/features/**' build",
    "build:dx": "pnpm --filter './packages/dx/**' build",
    "build:utils": "pnpm --filter './packages/utils/**' build",
    "build:cli": "pnpm --filter './packages/cli/**' build",
    "build:templates": "pnpm --filter './templates/**' build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "generate-templates": "node scripts/generate-templates.mjs"
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx}": "eslint --fix"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "@types/node": "^25.9.1"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
