{
  "name": "@praxisjs/content",
  "version": "0.2.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.js",
      "types": "./dist/vite.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@praxisjs/core": "workspace:^",
    "@praxisjs/decorators": "workspace:^",
    "marked": "^15.0.0"
  },
  "peerDependencies": {
    "vite": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
