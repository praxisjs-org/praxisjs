{
  "name": "create-praxisjs",
  "version": "1.0.6",
  "description": "Scaffold a new PraxisJS framework project",
  "type": "module",
  "bin": {
    "create-praxisjs": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "node ../../../scripts/generate-templates.mjs && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "picocolors": "^1.1.1",
    "praxisjs": "workspace:*"
  },
  "devDependencies": {
    "@praxisjs/composables": "workspace:*",
    "@praxisjs/concurrent": "workspace:*",
    "@praxisjs/core": "workspace:*",
    "@praxisjs/decorators": "workspace:*",
    "@praxisjs/devtools": "workspace:*",
    "@praxisjs/di": "workspace:*",
    "@praxisjs/jsx": "workspace:*",
    "@praxisjs/router": "workspace:*",
    "@praxisjs/runtime": "workspace:*",
    "@praxisjs/store": "workspace:*",
    "@types/node": "^25.9.1",
    "tsdown": "0.22.4",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "praxisjs",
    "create-praxisjs",
    "scaffold",
    "frontend",
    "framework"
  ],
  "packageManager": "pnpm@10.30.2"
}
