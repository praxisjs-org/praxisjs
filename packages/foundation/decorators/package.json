{
  "name": "@praxisjs/decorators",
  "version": "2.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@praxisjs/core": "workspace:^",
    "@praxisjs/shared": "workspace:^"
  }
}
