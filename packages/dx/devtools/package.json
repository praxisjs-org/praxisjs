{
  "name": "@praxisjs/devtools",
  "version": "0.3.2",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets",
    "src",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate:css": "unocss \"src/**/*.{ts,tsx}\" -o assets/uno.generated.css",
    "build": "vite build",
    "prebuild": "pnpm run generate:css",
    "dev": "vite build --watch"
  },
  "dependencies": {
    "@praxisjs/core": "workspace:^",
    "@praxisjs/decorators": "workspace:^",
    "@praxisjs/jsx": "workspace:^",
    "@praxisjs/runtime": "workspace:^",
    "@praxisjs/shared": "workspace:^",
    "@unocss/reset": "^66.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@unocss/cli": "^66.6.7",
    "@unocss/preset-wind3": "^66.6.7",
    "typescript": "catalog:",
    "unocss": "^66.6.7",
    "vite": "catalog:",
    "vite-plugin-dts": "^4.5.4"
  },
  "packageManager": "pnpm@10.30.2"
}
