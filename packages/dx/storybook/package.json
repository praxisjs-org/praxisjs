{
  "name": "@praxisjs/storybook",
  "version": "0.2.11",
  "type": "module",
  "description": "Storybook framework adapter for PraxisJS",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js"
    }
  },
  "files": [
    "dist",
    "manager.jsx",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@praxisjs/runtime": "workspace:*",
    "@praxisjs/vite-plugin": "workspace:*"
  },
  "peerDependencies": {
    "@storybook/builder-vite": ">=8.0.0",
    "storybook": ">=8.0.0"
  },
  "devDependencies": {
    "@storybook/builder-vite": "^10.4.0",
    "storybook": "^10.4.0",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
