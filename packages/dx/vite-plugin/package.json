{
  "name": "@praxisjs/vite-plugin",
  "version": "4.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@praxisjs/css": "workspace:*",
    "vite": ">=8.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "esbuild": "^0.28.1",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@praxisjs/css": "workspace:*",
    "@types/node": "^25.9.1",
    "vite": "catalog:"
  }
}
