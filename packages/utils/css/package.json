{
  "name": "@praxisjs/css",
  "version": "0.3.6",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./extract": {
      "import": "./dist/extract.js",
      "types": "./dist/extract.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "!dist/**/__tests__",
    "!src/**/__tests__",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.30.2",
  "devDependencies": {
    "typescript": "catalog:"
  },
  "dependencies": {
    "@praxisjs/core": "workspace:^",
    "@praxisjs/decorators": "workspace:^",
    "csstype": "^3.2.3"
  }
}
